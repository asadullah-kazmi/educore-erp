<Window x:Class="SchoolERP.Views.ExamSlipDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Slip"
        Width="820"
        Height="650"
        MinWidth="500"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#EEF2F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#001A3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="Border" x:Key="RowBorderStyle">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="Border" x:Key="ColBorderStyle">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="Border" x:Key="TopColBorderStyle">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
        </Style>
        <Style TargetType="Border" x:Key="TopRowBorderStyle">
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
        </Style>
        <Style TargetType="TextBox" x:Key="TableLabelStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="TextBox" x:Key="TableValueStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28"
                MinWidth="420">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="70" Height="70" Stretch="Uniform" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GRAMMAR PUBLIC SCHOOL, GHAZIKOT, MANSEHRA"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#001A3F"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TermName, StringFormat='{}{0} Exam Slip'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   HorizontalAlignment="Left"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>



                <!-- Grid Details in Tabular Form -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="45"/>
                        <RowDefinition Height="Auto" MinHeight="45"/>
                        <RowDefinition Height="Auto" MinHeight="45"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TopColBorderStyle}" Background="#F8FAFC">
                        <TextBox Text="EXAM NUMBER" Style="{StaticResource TableLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TopColBorderStyle}">
                        <TextBox Text="{Binding ExamNumber, Mode=OneWay}" Style="{StaticResource TableValueStyle}" FontSize="18" FontWeight="Bold" Foreground="#001A3F"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TopColBorderStyle}" Background="#F8FAFC">
                        <TextBox Text="GENERATED" Style="{StaticResource TableLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource TopRowBorderStyle}">
                        <TextBox Text="{Binding GeneratedOnDisplay, Mode=OneWay}" Style="{StaticResource TableValueStyle}"/>
                    </Border>

                    <!-- Row 1 -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ColBorderStyle}" Background="#F8FAFC">
                        <TextBox Text="STUDENT" Style="{StaticResource TableLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ColBorderStyle}">
                        <TextBox Text="{Binding StudentName, Mode=OneWay}" Style="{StaticResource TableValueStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ColBorderStyle}" Background="#F8FAFC">
                        <TextBox Text="FATHER" Style="{StaticResource TableLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource RowBorderStyle}">
                        <TextBox Text="{Binding FatherName, Mode=OneWay}" Style="{StaticResource TableValueStyle}"/>
                    </Border>

                    <!-- Row 2 -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ColBorderStyle}" Background="#F8FAFC">
                        <TextBox Text="REGISTRATION NO" Style="{StaticResource TableLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ColBorderStyle}">
                        <TextBox Text="{Binding RegistrationNo, Mode=OneWay}" Style="{StaticResource TableValueStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ColBorderStyle}" Background="#F8FAFC">
                        <TextBox Text="CLASS / SECTION" Style="{StaticResource TableLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource RowBorderStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding ClassName, Mode=OneWay}" Style="{StaticResource TableValueStyle}" Margin="12,0,4,0"/>
                            <TextBox Text="-" Foreground="#64748B" VerticalAlignment="Center" FontWeight="Bold" BorderThickness="0" Background="Transparent" IsReadOnly="True"/>
                            <TextBox Text="{Binding Section, Mode=OneWay}" Style="{StaticResource TableValueStyle}" Margin="4,0,12,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Print"
                    Click="Print_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="Close"
                    Click="Close_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Background="#F1F5F9"
                    Foreground="#334155"/>
        </StackPanel>
    </Grid>
</Window>
